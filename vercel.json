{
  "cleanUrls": true,
  "redirects": [
    { "source": "/menu", "destination": "/#menu", "permanent": true },
    { "source": "/reviews", "destination": "/#visit", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
